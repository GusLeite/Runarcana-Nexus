# Copie para .env (fora do Git) no servidor.
# Domínio apontando para o servidor; o Caddy emite o certificado HTTPS sozinho.
SITE_ADDRESS=mesa.exemplo.com
# Senha do PostgreSQL de produção (use letras e números; gere com: openssl rand -hex 24).
DB_PASSWORD=
# Senha inicial da conta "mestre", usada só na criação da conta; o site pede a troca no primeiro acesso.
RUNARCANA_MASTER_PASSWORD=
